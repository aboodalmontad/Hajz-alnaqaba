# GEMINI_API_KEY: Required for Gemini AI API calls (if used).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# ==============================================================================
# بيئة التشغيل السحابية الآمنة - أسرار ومتغيرات بيئة Supabase لنقابة المحامين
# Secure Server-Side Secrets for Supabase & Multi-Branch Synchronization
# ==============================================================================
# رابط مشروع Supabase المركزي
SUPABASE_URL="https://your-project-id.supabase.co"

# المفتاح السري الآمن في الخادم (service_role key أو anon key)
# يتم وضعه هنا أو في لوحة الأسرار (Secrets) لمنع تسريبه للمتصفح
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# إعدادات المكتب والفرع لهذا الجهاز
BRANCH_ID="branch-aleppo-main"
BRANCH_NAME="المقر الرئيسي - القصر العدلي بحلب"
BRANCH_CODE="ALP-MAIN"
IS_HQ="true"


